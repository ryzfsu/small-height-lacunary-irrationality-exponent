namespace Lacunary.CFBridge

open GenContFract

/-- The simple continued fraction generated by a rational terminates. -/
theorem rat_terminates (r : ℚ) : (GenContFract.of (r : ℝ)).Terminates := by
  exact (GenContFract.of_terminates_iff_of_rat_terminates (K := ℝ) rfl).2
    (GenContFract.terminates_of_rat r)

/-- A terminating rational expansion evaluates to its input at the terminal index. -/
theorem rat_terminal_convergent (r : ℚ) :
    ∃ n, (GenContFract.of (r : ℝ)).TerminatedAt n ∧
      (GenContFract.of (r : ℝ)).convs n = r := by
  obtain ⟨n, hn⟩ := rat_terminates r
  exact ⟨n, hn, (GenContFract.of_correctness_of_terminatedAt hn).symm⟩

/-- A convergent unequal to the target occurs before termination. -/
theorem not_terminated_of_ne {x : ℝ} {n : ℕ}
    (h : x ≠ (GenContFract.of x).convs n) :
    ¬(GenContFract.of x).TerminatedAt n := by
  intro ht
  exact h (GenContFract.of_correctness_of_terminatedAt ht)

/-- Legendre's criterion, with no irrationality assumption on the target. -/
theorem legendre_nonterminal {x : ℝ} {r : ℚ}
    (h : |x - r| < 1 / (2 * (r.den : ℝ) ^ 2)) (hne : x ≠ (r : ℝ)) :
    ∃ n, (GenContFract.of x).convs n = r ∧
      ¬(GenContFract.of x).TerminatedAt n := by
  obtain ⟨n, hn⟩ := Real.exists_convs_eq_rat h
  exact ⟨n, hn, not_terminated_of_ne (hn ▸ hne)⟩

/-- The upper half of the paper's convergent error estimate. -/
theorem error_upper {x : ℝ} {n : ℕ}
    (hn : ¬(GenContFract.of x).TerminatedAt n) :
    |x - (GenContFract.of x).convs n| ≤
      1 / ((GenContFract.of x).dens n * (GenContFract.of x).dens (n + 1)) :=
  GenContFract.abs_sub_convs_le hn

/-- Consecutive simple-CF convergents have determinant `(-1)^(n+1)`. -/
theorem determinant {x : ℝ} {n : ℕ}
    (hn : ¬(GenContFract.of x).TerminatedAt n) :
    (GenContFract.of x).nums n * (GenContFract.of x).dens (n + 1) -
      (GenContFract.of x).dens n * (GenContFract.of x).nums (n + 1) =
        (-1) ^ (n + 1) := by
  exact (SimpContFract.of x).determinant hn

/-- Denominators of the continued fraction are positive. -/
theorem dens_pos (x : ℝ) (n : ℕ) : 0 < (GenContFract.of x).dens n := by
  have hm : Monotone (GenContFract.of x).dens :=
    monotone_nat_of_le_succ fun _ => GenContFract.of_den_mono
  have h := hm (Nat.zero_le n)
  simpa only [GenContFract.zeroth_den_eq_one] using lt_of_lt_of_le zero_lt_one h

/-- The lower half of the paper's convergent error estimate. -/
theorem error_lower {x : ℝ} {n : ℕ}
    (hn : ¬(GenContFract.of x).TerminatedAt n) :
    1 / ((GenContFract.of x).dens n *
      ((GenContFract.of x).dens (n + 1) + (GenContFract.of x).dens n)) ≤
      |x - (GenContFract.of x).convs n| := by
  let g := GenContFract.of x
  let nextConts := g.contsAux (n + 2)
  set conts := g.contsAux (n + 1) with conts_eq
  set predConts := g.contsAux n with predConts_eq
  change 1 / (conts.b * (nextConts.b + conts.b)) ≤ |x - g.convs n|
  obtain ⟨gp, hs⟩ : ∃ gp, g.s.get? n = some gp :=
    Option.ne_none_iff_exists'.1 hn
  have ha : gp.a = 1 := of_partNum_eq_one (partNum_eq_s_a hs)
  have hnext : nextConts.b = predConts.b + gp.b * conts.b := by
    simp [nextConts, contsAux_recurrence hs predConts_eq conts_eq, ha,
      predConts_eq.symm, conts_eq.symm, add_comm]
  obtain ⟨ipNext, hstreamNext, hb⟩ :
      ∃ ipNext, IntFractPair.stream x (n + 1) = some ipNext ∧
        (ipNext.b : ℝ) = gp.b :=
    IntFractPair.exists_succ_get?_stream_of_gcf_of_get?_eq_some hs
  obtain ⟨ip, hstream, hfr, hip⟩ :
      ∃ ip, IntFractPair.stream x n = some ip ∧ ip.fr ≠ 0 ∧
        IntFractPair.of ip.fr⁻¹ = ipNext :=
    IntFractPair.succ_nth_stream_eq_some_iff.1 hstreamNext
  have hfloor : (⌊ip.fr⁻¹⌋ : ℝ) = gp.b := by
    change ((IntFractPair.of ip.fr⁻¹).b : ℝ) = gp.b
    rw [hip]
    exact hb
  have htail : ip.fr⁻¹ < gp.b + 1 := by
    simpa only [hfloor] using Int.lt_floor_add_one ip.fr⁻¹
  have hB : 0 < conts.b := dens_pos x n
  have hpB : 0 ≤ predConts.b := zero_le_of_contsAux_b
  have hfrPos : 0 < ip.fr :=
    lt_of_le_of_ne (IntFractPair.nth_stream_fr_nonneg hstream) hfr.symm
  let D := conts.b * (predConts.b + ip.fr⁻¹ * conts.b)
  have hD : 0 < D := by dsimp [D]; positivity
  have hDle : D ≤ conts.b * (nextConts.b + conts.b) := by
    have hh : ip.fr⁻¹ * conts.b ≤ (gp.b + 1) * conts.b :=
      mul_le_mul_of_nonneg_right htail.le hB.le
    dsimp [D]
    rw [hnext]
    apply mul_le_mul_of_nonneg_left _ hB.le
    nlinarith
  have herr : |x - g.convs n| = 1 / D := by
    have heq : x - g.convs n = (-1) ^ n / D := by
      simpa [g, D, conts, predConts, hfr, add_comm] using sub_convs_eq hstream
    rw [heq, abs_div, abs_neg_one_pow, abs_of_pos hD]
  rw [herr]
  exact div_le_div_of_nonneg_left zero_le_one hD hDle


/-- Every continuant of the regular expansion has integral coordinates. -/
theorem exists_int_contsAux (x : ℝ) (n : ℕ) :
    ∃ a b : ℤ, (GenContFract.of x).contsAux n = ⟨(a : ℝ), (b : ℝ)⟩ := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with (_ | _ | n)
    · exact ⟨1, 0, by simp [GenContFract.contsAux]⟩
    · exact ⟨⌊x⌋, 1, by simp [GenContFract.contsAux]⟩
    · obtain ⟨pa, pb, hp⟩ := ih (n + 1) (by omega)
      rcases hs : (GenContFract.of x).s.get? n with _ | gp
      · refine ⟨pa, pb, ?_⟩
        simpa only [GenContFract.contsAux, hs] using hp
      · obtain ⟨ppa, ppb, hpp⟩ := ih n (by omega)
        obtain ⟨ha, z, hb⟩ := of_partNum_eq_one_and_exists_int_partDen_eq hs
        refine ⟨z * pa + ppa, z * pb + ppb, ?_⟩
        rw [contsAux_recurrence hs hpp hp, ha, hb]
        simp

/-- Every finite convergent is a ratio of integral continuants. -/
theorem exists_int_conts (x : ℝ) (n : ℕ) :
    ∃ a b : ℤ, (GenContFract.of x).nums n = (a : ℝ) ∧
      (GenContFract.of x).dens n = (b : ℝ) := by
  obtain ⟨a, b, h⟩ := exists_int_contsAux x (n + 1)
  exact ⟨a, b, congrArg GenContFract.Pair.a h, congrArg GenContFract.Pair.b h⟩

/-- The canonical terminal index is the first terminated index of Mathlib's algorithm. -/
noncomputable def rationalLength (r : ℚ) : ℕ := Nat.find (rat_terminates r)

@[simp] theorem rationalLength_terminated (r : ℚ) :
    (GenContFract.of (r : ℝ)).TerminatedAt (rationalLength r) :=
  Nat.find_spec (rat_terminates r)

theorem rationalLength_not_terminated (r : ℚ) {n : ℕ} (hn : n < rationalLength r) :
    ¬(GenContFract.of (r : ℝ)).TerminatedAt n :=
  Nat.find_min (rat_terminates r) hn

/-- There is a stream entry at every quotient through the canonical terminal index. -/
theorem rational_stream_exists (r : ℚ) {n : ℕ} (hn : n ≤ rationalLength r) :
    ∃ ip, IntFractPair.stream (r : ℝ) n = some ip := by
  cases n with
  | zero => exact ⟨IntFractPair.of (r : ℝ), rfl⟩
  | succ n =>
    have hnt := rationalLength_not_terminated r (show n < rationalLength r by omega)
    have hnnone : IntFractPair.stream (r : ℝ) (n + 1) ≠ none := by
      exact fun h => hnt (of_terminatedAt_n_iff_succ_nth_intFractPair_stream_eq_none.2 h)
    exact Option.ne_none_iff_exists'.1 hnnone

/-- The canonical quotient at a natural index; the finite adapter restricts to its length. -/
noncomputable def rationalQuotient (r : ℚ) (n : ℕ) : ℤ :=
  ((IntFractPair.stream (r : ℝ) n).getD ⟨0, 0⟩).b

@[simp] theorem rationalQuotient_zero (r : ℚ) : rationalQuotient r 0 = ⌊(r : ℝ)⌋ := rfl

theorem rationalQuotient_eq {r : ℚ} {n : ℕ} {ip : IntFractPair ℝ}
    (h : IntFractPair.stream (r : ℝ) n = some ip) : rationalQuotient r n = ip.b := by
  simp [rationalQuotient, h]

/-- Every noninitial quotient in the finite expansion is positive. -/
theorem rationalQuotient_pos (r : ℚ) {n : ℕ} (h0 : 0 < n)
    (hn : n ≤ rationalLength r) : 1 ≤ rationalQuotient r n := by
  obtain ⟨ip, hip⟩ := rational_stream_exists r hn
  rw [rationalQuotient_eq hip]
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt h0)
  exact IntFractPair.one_le_succ_nth_stream_b hip

/-- A nonintegral rational has final canonical quotient at least two. -/
theorem rationalQuotient_last (r : ℚ) (h0 : 0 < rationalLength r) :
    2 ≤ rationalQuotient r (rationalLength r) := by
  obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt h0)
  obtain ⟨ip, hip⟩ := rational_stream_exists r (Nat.le_refl (rationalLength r))
  have hnext : IntFractPair.stream (r : ℝ) (rationalLength r + 1) = none :=
    of_terminatedAt_n_iff_succ_nth_intFractPair_stream_eq_none.1 (rationalLength_terminated r)
  have hfr : ip.fr = 0 := by
    by_contra hnzero
    rw [IntFractPair.stream, hip, Option.bind_some, ite_eq_right hnzero] at hnext
    contradiction
  rw [rationalQuotient_eq hip]
  rw [hk] at hip
  obtain ⟨prev, hp, hpnz, hstep⟩ := IntFractPair.succ_nth_stream_eq_some_iff.1 hip
  have hpos : 0 < prev.fr :=
    lt_of_le_of_ne (IntFractPair.nth_stream_fr_nonneg hp) hpnz.symm
  have hlt : prev.fr < 1 := IntFractPair.nth_stream_fr_lt_one hp
  have hvalue : prev.fr⁻¹ = (ip.b : ℝ) := by
    have hbip : ⌊prev.fr⁻¹⌋ = ip.b := congrArg IntFractPair.b hstep
    have hf := congrArg IntFractPair.fr hstep
    change prev.fr⁻¹ - (⌊prev.fr⁻¹⌋ : ℝ) = ip.fr at hf
    rw [hbip, hfr] at hf
    exact sub_eq_zero.1 hf
  have hgt : (1 : ℝ) < (ip.b : ℝ) := by
    rw [← hvalue]
    exact (one_lt_inv₀ hpos).2 hlt
  have hi : (1 : ℤ) < ip.b := by exact_mod_cast hgt
  omega

/-- The canonical finite expansion ends at the original rational. -/
theorem rationalLength_convergent (r : ℚ) :
    (GenContFract.of (r : ℝ)).convs (rationalLength r) = r :=
  (GenContFract.of_correctness_of_terminatedAt (rationalLength_terminated r)).symm


/-- The determinant shows that each nonrepeated convergent is already reduced. -/
theorem continuants_coprime {x : ℝ} {n : ℕ} {a b : ℤ}
    (ha : (GenContFract.of x).nums n = (a : ℝ))
    (hb : (GenContFract.of x).dens n = (b : ℝ))
    (hpre : n = 0 ∨ ¬(GenContFract.of x).TerminatedAt (n - 1)) :
    Nat.Coprime a.natAbs b.natAbs := by
  cases n with
  | zero =>
    have hbeq : (b : ℝ) = 1 := by simpa using hb.symm
    have hb1 : b = 1 := by exact_mod_cast hbeq
    simp [hb1]
  | succ n =>
    have hn : ¬(GenContFract.of x).TerminatedAt n := by simpa using hpre
    obtain ⟨pa, pb, hpa, hpb⟩ := exists_int_conts x n
    have hdet := determinant hn
    rw [hpa, hpb, ha, hb] at hdet
    have hidet : pa * b - pb * a = (-1 : ℤ) ^ (n + 1) := by exact_mod_cast hdet
    apply Int.isCoprime_iff_nat_coprime.1
    refine ⟨-pb * (-1) ^ (n + 1), pa * (-1) ^ (n + 1), ?_⟩
    calc
      _ = (pa * b - pb * a) * (-1) ^ (n + 1) := by ring
      _ = 1 := by rw [hidet, ← mul_pow]; simp

/-- Identify the actual reduced numerator and denominator of a rational convergent. -/
theorem convergent_num_den {x : ℝ} {r : ℚ} {n : ℕ}
    (hconv : (GenContFract.of x).convs n = (r : ℝ))
    (hpre : n = 0 ∨ ¬(GenContFract.of x).TerminatedAt (n - 1)) :
    (GenContFract.of x).nums n = (r.num : ℝ) ∧
      (GenContFract.of x).dens n = (r.den : ℝ) := by
  obtain ⟨a, b, ha, hb⟩ := exists_int_conts x n
  have hbpos : (0 : ℤ) < b := by
    have hp := dens_pos x n
    rw [hb] at hp
    exact_mod_cast hp
  have hcop := continuants_coprime ha hb hpre
  have hrr : (((a : ℚ) / (b : ℚ) : ℚ) : ℝ) = (r : ℝ) := by
    push_cast
    rw [← ha, ← hb, ← GenContFract.conv_eq_num_div_den]
    exact hconv
  have hr : (a : ℚ) / (b : ℚ) = r := by exact_mod_cast hrr
  have hna : r.num = a := by rw [← hr]; exact Rat.num_div_eq_of_coprime hbpos hcop
  have hdb : (r.den : ℤ) = b := by rw [← hr]; exact Rat.den_div_eq_of_coprime hbpos hcop
  constructor
  · rw [ha, hna]
  · rw [hb, ← hdb]; norm_cast

/-- Every continued-fraction denominator is a positive natural number. -/
theorem exists_nat_den (x : ℝ) (n : ℕ) :
    ∃ d : ℕ, 0 < d ∧ (GenContFract.of x).dens n = (d : ℝ) := by
  obtain ⟨a, b, ha, hb⟩ := exists_int_conts x n
  have hbpos : (0 : ℤ) < b := by
    have hp := dens_pos x n
    rw [hb] at hp
    exact_mod_cast hp
  lift b to ℕ using hbpos.le with d hd
  exact ⟨d, by exact_mod_cast hbpos, by simpa using hb⟩

/-- A nonterminal convergent has its canonical reduced rational denominator. -/
theorem nonterminal_num_den {x : ℝ} {r : ℚ} {n : ℕ}
    (hconv : (GenContFract.of x).convs n = (r : ℝ))
    (hn : ¬(GenContFract.of x).TerminatedAt n) :
    (GenContFract.of x).nums n = (r.num : ℝ) ∧
      (GenContFract.of x).dens n = (r.den : ℝ) :=
  convergent_num_den hconv (Or.inr (mt (terminated_stable (Nat.sub_le n 1)) hn))

/-- The canonical finite expansion's terminal continuants are the reduced rational pair. -/
theorem rationalLength_num_den (r : ℚ) :
    (GenContFract.of (r : ℝ)).nums (rationalLength r) = (r.num : ℝ) ∧
      (GenContFract.of (r : ℝ)).dens (rationalLength r) = (r.den : ℝ) := by
  apply convergent_num_den (rationalLength_convergent r)
  rcases eq_or_ne (rationalLength r) 0 with h | h
  · exact Or.inl h
  · exact Or.inr (rationalLength_not_terminated r (Nat.sub_lt (Nat.pos_of_ne_zero h) zero_lt_one))

/-- The paper's two-sided error bounds use the reduced denominator and an actual next denominator. -/
theorem convergent_next_den {x : ℝ} {r : ℚ} {n : ℕ}
    (hconv : (GenContFract.of x).convs n = (r : ℝ))
    (hn : ¬(GenContFract.of x).TerminatedAt n) :
    ∃ d : ℕ, 0 < d ∧ r.den ≤ d ∧
      (GenContFract.of x).dens (n + 1) = (d : ℝ) ∧
      1 / ((r.den : ℝ) * ((d : ℝ) + (r.den : ℝ))) ≤ |x - (r : ℝ)| ∧
      |x - (r : ℝ)| ≤ 1 / ((r.den : ℝ) * (d : ℝ)) := by
  obtain ⟨d, hd, hdeq⟩ := exists_nat_den x (n + 1)
  have hden := (nonterminal_num_den hconv hn).2
  have hmono : r.den ≤ d := by
    have hm : (GenContFract.of x).dens n ≤ (GenContFract.of x).dens (n + 1) := of_den_mono
    rw [hden, hdeq] at hm
    exact_mod_cast hm
  refine ⟨d, hd, hmono, hdeq, ?_, ?_⟩
  · simpa only [hden, hdeq, hconv] using error_lower hn
  · simpa only [hden, hdeq, hconv] using error_upper hn

/-- Legendre's criterion followed by the reduced-denominator, next-denominator adapter. -/
theorem legendre_next_den {x : ℝ} {r : ℚ}
    (h : |x - r| < 1 / (2 * (r.den : ℝ) ^ 2)) (hne : x ≠ (r : ℝ)) :
    ∃ n d : ℕ, (GenContFract.of x).convs n = r ∧
      ¬(GenContFract.of x).TerminatedAt n ∧ 0 < d ∧ r.den ≤ d ∧
      (GenContFract.of x).dens (n + 1) = (d : ℝ) ∧
      1 / ((r.den : ℝ) * ((d : ℝ) + (r.den : ℝ))) ≤ |x - (r : ℝ)| ∧
      |x - (r : ℝ)| ≤ 1 / ((r.den : ℝ) * (d : ℝ)) := by
  obtain ⟨n, hconv, hn⟩ := legendre_nonterminal h hne
  obtain ⟨d, hd, hmono, hdeq, hlo, hup⟩ := convergent_next_den hconv hn
  exact ⟨n, d, hconv, hn, hd, hmono, hdeq, hlo, hup⟩


/-- The canonical finite list, including the initial integer quotient. -/
noncomputable def rationalExpansion (r : ℚ) : List ℤ :=
  List.ofFn fun i : Fin (rationalLength r + 1) => rationalQuotient r i

@[simp] theorem rationalExpansion_length (r : ℚ) :
    (rationalExpansion r).length = rationalLength r + 1 := by
  simp [rationalExpansion]

theorem rationalExpansion_ne_nil (r : ℚ) : rationalExpansion r ≠ [] := by
  intro h
  have := congrArg List.length h
  simp at this

theorem rationalExpansion_get (r : ℚ) (i : Fin (rationalLength r + 1)) :
    (rationalExpansion r)[i.val]'(by simpa using i.isLt) = rationalQuotient r i := by
  simp only [rationalExpansion, List.getElem_ofFn]

@[simp] theorem rationalExpansion_last (r : ℚ) :
    (rationalExpansion r).getLast (rationalExpansion_ne_nil r) =
      rationalQuotient r (rationalLength r) := by
  exact List.getLast_ofFn_succ (fun i : Fin (rationalLength r + 1) => rationalQuotient r i)

/-- All noninitial entries are positive and the noninitial final entry is at least two. -/
theorem rationalExpansion_regular (r : ℚ) :
    (∀ (i : ℕ) (hi : i < (rationalExpansion r).length), 0 < i →
      1 ≤ (rationalExpansion r)[i]) ∧
    (0 < rationalLength r → 2 ≤ (rationalExpansion r).getLast (rationalExpansion_ne_nil r)) := by
  constructor
  · intro i hi h0
    have hilt : i < rationalLength r + 1 := by simpa using hi
    rw [rationalExpansion_get r ⟨i, hilt⟩]
    exact rationalQuotient_pos r h0 (by omega)
  · intro h0
    rw [rationalExpansion_last]
    exact rationalQuotient_last r h0

/-- Repackage the finite canonical quotients as a finite generalized continued fraction. -/
noncomputable def rationalFiniteCF (r : ℚ) : GenContFract ℝ :=
  ⟨(rationalQuotient r 0 : ℝ), Stream'.Seq.ofList
    (List.ofFn fun i : Fin (rationalLength r) =>
      (⟨1, (rationalQuotient r (i.val + 1) : ℝ)⟩ : GenContFract.Pair ℝ))⟩

/-- The finite list packaging is exactly Mathlib's canonical continued fraction. -/
theorem rationalFiniteCF_eq (r : ℚ) :
    rationalFiniteCF r = GenContFract.of (r : ℝ) := by
  apply GenContFract.ext
  · simp [rationalFiniteCF]
  · apply Stream'.Seq.ext
    intro n
    by_cases hn : n < rationalLength r
    · obtain ⟨ip, hip⟩ := rational_stream_exists r (show n + 1 ≤ rationalLength r by omega)
      have hs := get?_of_eq_some_of_succ_get?_intFractPair_stream hip
      rw [hs]
      simp [rationalFiniteCF, Stream'.Seq.ofList_get?, hn, rationalQuotient_eq hip]
    · have ht : (GenContFract.of (r : ℝ)).TerminatedAt n :=
        terminated_stable (Nat.le_of_not_gt hn) (rationalLength_terminated r)
      change (rationalFiniteCF r).s.get? n = _
      rw [show (GenContFract.of (r : ℝ)).s.get? n = none from ht]
      simp [rationalFiniteCF, Stream'.Seq.ofList_get?, hn]

/-- Evaluation of the canonical finite list at its last convergent returns the input rational. -/
theorem rationalFiniteCF_value (r : ℚ) :
    (rationalFiniteCF r).convs (rationalLength r) = (r : ℝ) := by
  rw [rationalFiniteCF_eq]
  exact rationalLength_convergent r

end Lacunary.CFBridge
